{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Migration Specifics */
        "allowJs": true, // This allows your old .js files to work
        "checkJs": false, // Don't report errors in old .js files
        "strict": false, // Set to false initially to avoid a "sea of red"
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src"
    ]
}